{
  "info": {
    "name": "Mini E-commerce API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login (get token)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"yourpassword\"\n}"
        },
        "url": "{{base_url}}/login/"
      }
    },
    {
      "name": "Categories - List",
      "request": { "method": "GET", "url": "{{base_url}}/categories/" }
    },
    {
      "name": "Categories - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Gadgets and devices\"\n}"
        },
        "url": "{{base_url}}/categories/"
      }
    },
    {
      "name": "Categories - Retrieve",
      "request": { "method": "GET", "url": "{{base_url}}/categories/1/" }
    },
    {
      "name": "Categories - Update",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Electronics & Gadgets\",\n  \"description\": \"Updated description\"\n}"
        },
        "url": "{{base_url}}/categories/1/"
      }
    },
    {
      "name": "Categories - Delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
        "url": "{{base_url}}/categories/1/"
      }
    },
    {
      "name": "Products - List",
      "request": { "method": "GET", "url": "{{base_url}}/products/" }
    },
    {
      "name": "Products - Search by name",
      "request": { "method": "GET", "url": "{{base_url}}/products/?search=phone" }
    },
    {
      "name": "Products - Filter by category",
      "request": { "method": "GET", "url": "{{base_url}}/products/?category=1" }
    },
    {
      "name": "Products - Filter by price range",
      "request": { "method": "GET", "url": "{{base_url}}/products/?price_min=50&price_max=500" }
    },
    {
      "name": "Products - Order by price",
      "request": { "method": "GET", "url": "{{base_url}}/products/?ordering=price" }
    },
    {
      "name": "Products - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Smartphone\",\n  \"description\": \"A great phone\",\n  \"price\": \"299.99\",\n  \"stock\": 25,\n  \"category\": 1\n}"
        },
        "url": "{{base_url}}/products/"
      }
    },
    {
      "name": "Products - Retrieve",
      "request": { "method": "GET", "url": "{{base_url}}/products/1/" }
    },
    {
      "name": "Products - Update",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"stock\": 20\n}" },
        "url": "{{base_url}}/products/1/"
      }
    },
    {
      "name": "Products - Delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
        "url": "{{base_url}}/products/1/"
      }
    },
    {
      "name": "Orders - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": 1,\n  \"quantity\": 2\n}"
        },
        "url": "{{base_url}}/orders/"
      }
    },
    {
      "name": "Orders - List (mine)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
        "url": "{{base_url}}/orders/"
      }
    },
    {
      "name": "Orders - Retrieve",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Token {{token}}" }],
        "url": "{{base_url}}/orders/1/"
      }
    }
  ]
}
